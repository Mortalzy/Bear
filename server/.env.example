HOST=127.0.0.1
PORT=3001
# Enable only for Nginx on the same server, with HOST=127.0.0.1.
# Nginx must overwrite X-Forwarded-For with $remote_addr.
TRUST_PROXY=loopback
# Yandex Mail: use an application-specific password. Never commit server/.env.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=german-pironen@yandex.ru
SMTP_PASSWORD=
COMPANY_EMAIL=german-pironen@yandex.ru
# No PUBLIC_BASE_URL is needed: files are sent as email attachments.
# Optional temporary directory outside the web root. Default: server/storage.
# UPLOAD_DIR=/var/lib/bear/uploads
