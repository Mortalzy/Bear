HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Mail.ru: use an application-specific password. Never commit server/.env.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=bear.fiberglass@mail.ru
SMTP_PASSWORD=
COMPANY_EMAIL=bear.fiberglass@mail.ru
# No PUBLIC_BASE_URL is needed: files are sent as email attachments.
# Optional temporary directory outside the web root. Default: server/storage.
# UPLOAD_DIR=/var/lib/bear/uploads

# Closed private consent journal, outside the web root and Git.
# CONSENT_DIR=/var/lib/bear/consents

# Public legal details. Copy exact data from the owner's documents and provider contracts.
PUBLIC_SITE_URL=
OPERATOR_OGRNIP=
OPERATOR_ADDRESS=
PRIVACY_EMAIL=bear.fiberglass@mail.ru
# Each processor: full legal name and postal address; do not just write a brand.
HOSTING_PROCESSOR=
MAIL_PROCESSOR=

# Set to true ONLY after the owner has completed docs/PRIVACY_LAUNCH.md.
# These confirmations are not proof of compliance or RKN's approval.
PRIVACY_DOCUMENTS_APPROVED=false
RKN_NOTIFICATION_CONFIRMED=false
RU_DATA_LOCATION_CONFIRMED=false
